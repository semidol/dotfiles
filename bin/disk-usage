#!/usr/bin/env python3
"""Print disk usage as used/total, where used is derived as total - free.

psutil reports `used` from a separate source that excludes purgeable space
on macOS, so used/total never adds up. statvfs gives consistent numbers.
"""

import os
import sys

BINARY_UNIT = 1024
UNITS = ("K", "M", "G", "T", "P")

# On macOS the root volume is read-only; user data lives on a separate volume.
MACOS_DATA_VOLUME = "/System/Volumes/Data"


def default_path():
    return MACOS_DATA_VOLUME if sys.platform == "darwin" else "/"


def human(num_bytes):
    value = float(num_bytes)

    for unit in UNITS:
        value /= BINARY_UNIT

        if value < BINARY_UNIT:
            return f"{value:.1f}{unit}"

    return f"{value:.1f}{UNITS[-1]}"


def main():
    path = sys.argv[1] if len(sys.argv) > 1 else default_path()
    stats = os.statvfs(path)

    total = stats.f_blocks * stats.f_frsize
    free = stats.f_bavail * stats.f_frsize
    used = total - free

    print(f"{human(used)}/{human(total)}")


if __name__ == "__main__":
    main()
