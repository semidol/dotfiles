#!/usr/bin/env bash
set -e

# The dev VM keeps repos under ~/projects; the host uses ~/IT.
PROJECT_ROOT="${TMUX_PICK_ROOT:-$HOME/IT}"

if [ ! -d "$PROJECT_ROOT" ]; then
    PROJECT_ROOT="$HOME/projects"
fi

# 1. Prefer recent directories, falling back to a scan of the project root.
# A fresh VM has an empty zoxide database, so decide which list to offer
# before opening a picker rather than showing an empty one.
RECENT=$(zoxide query --list 2>/dev/null || true)

# Escape makes fzf exit non-zero, which set -e would treat as a failure.
if [ -n "$RECENT" ]; then
    DIR=$(printf '%s\n' "$RECENT" | fzf --prompt="Select project (recent) > ") || exit 0
else
    DIR=$(find "$PROJECT_ROOT" -mindepth 1 -maxdepth 3 -type d \
        -not -path '*/.git/*' |
        fzf --prompt="Select project (all) > ") || exit 0
fi

[ -z "$DIR" ] && exit 0

# 2. Ensure zoxide learns it
zoxide add "$DIR" 2>/dev/null || true

# 3. Enter project and launch tmux
cd "$DIR"
exec tmux-at .
