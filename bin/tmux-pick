#!/usr/bin/env bash
set -e

# The dev VM keeps repos under ~/projects; the host uses ~/IT.
PROJECT_ROOT="${TMUX_PICK_ROOT:-$HOME/IT}"

if [ ! -d "$PROJECT_ROOT" ]; then
    PROJECT_ROOT="$HOME/projects"
fi

# 1. Try zoxide interactive picker, but only when it has entries to offer.
# A fresh VM has an empty database, and zoxide would otherwise open an empty
# picker that has to be dismissed before the fallback runs.
if zoxide query --list 2>/dev/null | grep -q .; then
    DIR=$(_ZO_FZF_OPTS="--prompt='Select project (recent) > '" zoxide query -i 2>/dev/null || true)
fi

# 2. Fallback: scan the project root if zoxide had nothing or was dismissed
if [ -z "$DIR" ]; then
    DIR=$(find "$PROJECT_ROOT" -mindepth 1 -maxdepth 3 -type d \
        -not -path '*/.git/*' |
        fzf --prompt="Select project (all) > ")
fi

[ -z "$DIR" ] && exit 0

# 3. Ensure zoxide learns it
zoxide add "$DIR" 2>/dev/null || true

# 4. Enter project and launch tmux
cd "$DIR"
exec tmux-at .
